# Copy to .env.local for local dev, .env.production for deploy.
# When VITE_XAVVI_API_STORE_ID is unset, the app uses MOCK DATA (see src/lib/api.ts).
# When set, the app uses the real Xavvi API.

# Production:
#   VITE_XAVVI_API_BASE=https://shop.xavvi.com/api
#   VITE_XAVVI_API_STORE_ID=your_store_id_here
#
# Test / dev environment (has demo products):
#   VITE_XAVVI_API_BASE=https://shop-dev.xavvi.com/api
#   VITE_XAVVI_API_STORE_ID=11111
#
# Optional: explicit mode override
#   VITE_XAVVI_API_MODE=live | mock

VITE_SITE_URL=http://localhost:5173
